# build output
dist/
.astro/

# Jac build cache (compiled JS, vite dist, node_modules, SQLite anchor store)
.jac/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables — never commit any .env file
.env*
# ...except the placeholder template, which is safe to commit
!.env.example

# macOS
.DS_Store

# editors
.vscode/
.idea/

# bun
bun.lockb

# Local-dev-only symlink to public/. The `jac start` dev server resolves static
# assets from .jac/client/dist, dist/ and assets/ but never public/, so images
# 404 locally while production serves them fine (the scale server's static
# handler does check public/). Recreate with: ln -s public assets
assets

# Generated HTML: email exports/previews and one-off issue previews are built
# from the .md sources (tools/render_previews.jac); never commit them.
*.html

# Python bytecode (the sources are Jac now, but jac compiles through CPython)
__pycache__/
